local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()
local SaveManager = loadstring(game:HttpGet("https://raw.githubusercontent.com/dawid-scripts/Fluent/master/Addons/SaveManager.lua"))()
local InterfaceManager = loadstring(game:HttpGet("https://raw.githubusercontent.com/dawid-scripts/Fluent/master/Addons/InterfaceManager.lua"))()

local Window = Fluent:CreateWindow({
    Title = "Hunty Zombie",
    SubTitle = "By Hollow Moon Hub",
    TabWidth = 160,
    Size = UDim2.fromOffset(580, 460),
    Acrylic = true,
    Theme = "Dark",
    MinimizeKey = Enum.KeyCode.LeftControl
})
local Tabs = {
    Lobby = Window:AddTab({ Title = "Lobby", Icon = "armchair" }),
    Farm = Window:AddTab({ Title = "Farm", Icon = "monitor" }),
    Combat = Window:AddTab({ Title = "Combat", Icon = "sword" }),
    Settings = Window:AddTab({ Title = "Settings", Icon = "settings" })
}

local Options = Fluent.Options

local FarmTab = Tabs.Farm

local AutoAttackEnabled = false
local AttackConnection = nil

FarmTab:AddToggle("AutoAttack", {
    Title = "Auto Attack (Left Click Bypass)",
    Description = "Fires the real ByteNetReliable attack packet",
    Default = false,
    Callback = function(state)
        AutoAttackEnabled = state

        if state then
            Fluent:Notify({
                Title = "Auto Attack",
                Content = "Auto Attack ENABLED - Using real remote",
                Duration = 4
            })

            AttackConnection = game:GetService("RunService").Heartbeat:Connect(function()
                if AutoAttackEnabled then
                    local args = {
                        buffer.fromstring("\t\a\001"),
                        {
                            1773609962.345644   -- timestamp (you can change this if needed)
                        }
                    }
                    local success, err = pcall(function()
                        game:GetService("ReplicatedStorage"):WaitForChild("ByteNetReliable"):FireServer(unpack(args))
                    end)
                    
                    if not success then
                        warn("Attack failed:", err)
                    end
                end
            end)
        else
            if AttackConnection then
                AttackConnection:Disconnect()
                AttackConnection = nil
            end
            Fluent:Notify({
                Title = "Auto Attack",
                Content = "Auto Attack DISABLED",
                Duration = 3
            })
        end
    end
})

-- Optional: Add speed control (how fast it attacks)
FarmTab:AddSlider("AttackSpeed", {
    Title = "Attack Speed",
    Description = "Lower = faster attacks (be careful with anti-cheat)",
    Default = 0.05,
    Min = 0.01,
    Max = 0.3,
    Rounding = 2,
    Callback = function(Value)
        -- We can improve this later with task.wait() if you want
    end
})

SaveManager:SetLibrary(Fluent)
InterfaceManager:SetLibrary(Fluent)
SaveManager:IgnoreThemeSettings()
SaveManager:SetIgnoreIndexes({})
InterfaceManager:SetFolder("AnimeFinalQuest")
SaveManager:SetFolder("AnimeFinalQuest/specific-game")
InterfaceManager:BuildInterfaceSection(Tabs.Settings)
SaveManager:BuildConfigSection(Tabs.Settings)

Window:SelectTab(1)

SaveManager:LoadAutoloadConfig()
