-- Debug function to find remotes
local function FindAllRemotes()
    local remotes = {}
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    
    -- Search in ReplicatedStorage
    for _, child in ipairs(ReplicatedStorage:GetChildren()) do
        if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") or child:IsA("UnreliableRemoteEvent") then
            table.insert(remotes, {
                Name = child.Name,
                Class = child.ClassName,
                Path = child:GetFullName()
            })
        end
    end
    
    -- Search in ReplicatedStorage subfolders
    local function SearchFolder(folder, depth)
        if depth > 3 then return end
        for _, child in ipairs(folder:GetChildren()) do
            if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") or child:IsA("UnreliableRemoteEvent") then
                table.insert(remotes, {
                    Name = child.Name,
                    Class = child.ClassName,
                    Path = child:GetFullName()
                })
            elseif child:IsA("Folder") or child:IsA("Model") then
                SearchFolder(child, depth + 1)
            end
        end
    end
    
    SearchFolder(ReplicatedStorage, 1)
    return remotes
end

-- Function to find ByteNet remote
local function FindByteNetRemote()
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    
    -- Try direct path first
    local direct = ReplicatedStorage:FindFirstChild("ByteNetReliable")
    if direct and direct:IsA("RemoteEvent") then
        return direct
    end
    
    -- Search for any remote with ByteNet in name
    for _, remote in ipairs(FindAllRemotes()) do
        if remote.Name:find("ByteNet") or remote.Name:find("byte") then
            local obj = ReplicatedStorage:FindDescendant(remote.Name)
            if obj and obj:IsA("RemoteEvent") then
                return obj
            end
        end
    end
    
    return nil
end

-- Function to fire attack
local function FireAttack()
    local remote = FindByteNetRemote()
    if not remote then return false end
    
    local success = false
    
    -- Try different argument formats
    local argFormats = {
        function() remote:FireServer(buffer.fromstring("\t\a\001"), { tick() }) end,
        function() remote:FireServer("\t\a\001", { tick() }) end,
        function() remote:FireServer({ ["data"] = "\t\a\001", ["time"] = tick() }) end,
        function() remote:FireServer(tick()) end,
        function() remote:FireServer({ tick() }) end,
        function() remote:FireServer({ ["1"] = "\t\a\001", ["2"] = tick() }) end,
    }
    
    for _, format in ipairs(argFormats) do
        local s, e = pcall(format)
        if s then
            success = true
            break
        end
    end
    
    return success
end

