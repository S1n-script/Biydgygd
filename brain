-- Auto Attack Loop
task.spawn(function()
    while true do
        if AutoAttackEnabled then
            -- Try multiple methods
            local remote = FindByteNetRemote()
            
            if remote then
                -- Method 1: Original format
                pcall(function()
                    remote:FireServer(buffer.fromstring("\t\a\001"), { tick() })
                end)
                
                -- Small delay between attempts
                task.wait(0.01)
                
                -- Method 2: Alternative format
                pcall(function()
                    remote:FireServer("\t\a\001", tick())
                end)
            end
            
            task.wait(AttackDelay)
        else
            task.wait(0.1)
        end
    end
end)

