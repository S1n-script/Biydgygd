})

-- Attack Delay Slider
Tabs.Farm:AddSlider("AttackDelay", {
    Title = "Attack Delay",
    Description = "Lower = faster (0.10 ~ 0.18 recommended)",
    Default = 0.13,
    Min = 0.05,
    Max = 0.40,
    Rounding = 3,
    Callback = function(Value)
        AttackDelay = Value
    end
})

-- Improved attack loop using Heartbeat for better performance
AttackConnection = game:GetService("RunService").Heartbeat:Connect(function()
    if AutoAttackEnabled then
        FireAttack()
        task.wait(AttackDelay)
    end
end)

-- Alternative method if Heartbeat doesn't work well
task.spawn(function()
    while true do
        if AutoAttackEnabled then
            -- Try direct path as backup
            local remote = game:GetService("ReplicatedStorage"):FindFirstChild("ByteNetReliable")
            if remote then
                pcall(function()
                    remote:FireServer(buffer.fromstring("\t\a\001"), { tick() })
                end)
            end
            task.wait(AttackDelay)
        else
            task.wait(0.3)
        end
    end
end)

