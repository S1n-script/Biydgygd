    end
})

-- Remote checker
DebugSection:AddButton({
    Title = "Check Remote",
    Description = "Verify ByteNetReliable exists",
    Callback = function()
        local remote = FindByteNetRemote()
        if remote then
            Fluent:Notify({
                Title = "Remote Found",
                Content = "✅ ByteNetReliable exists at: " .. remote.Parent.Name .. "/" .. remote.Name,
                Duration = 4
            })
            
            -- Show remote info in console
            print("=== Remote Info ===")
            print("Name:", remote.Name)
            print("Class:", remote.ClassName)
            print("Parent:", remote.Parent.FullName)
            print("===================")
        else
            Fluent:Notify({
                Title = "Remote Not Found",
                Content = "❌ ByteNetReliable not found in ReplicatedStorage",
                Duration = 4
            })
            
            -- List available remotes
            print("=== Available RemoteEvents in ReplicatedStorage ===")
            for _, child in ipairs(game:GetService("ReplicatedStorage"):GetChildren()) do
                if child:IsA("RemoteEvent") then
                    print("Found:", child.Name)
                end
            end
        end
    end
})

-- Status indicator
