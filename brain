local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()
local SaveManager = loadstring(game:HttpGet("https://raw.githubusercontent.com/dawid-scripts/Fluent/master/Addons/SaveManager.lua"))()
local InterfaceManager = loadstring(game:HttpGet("https://raw.githubusercontent.com/dawid-scripts/Fluent/master/Addons/InterfaceManager.lua"))()

local Window = Fluent:CreateWindow({
    Title = "Hunty Zombie",
    SubTitle = "By Hollow Moon Hub",
    TabWidth = 160,
    Size = UDim2.fromOffset(580, 460),
    Acrylic = true,
    Theme = "Dark",
    MinimizeKey = Enum.KeyCode.LeftControl
})
local Tabs = {
    Lobby = Window:AddTab({ Title = "Lobby", Icon = "armchair" }),
    Farm = Window:AddTab({ Title = "Farm", Icon = "monitor" }),
    Combat = Window:AddTab({ Title = "Combat", Icon = "sword" }),
    Settings = Window:AddTab({ Title = "Settings", Icon = "settings" })
}

local Options = Fluent.Options

local FarmTab = Tabs.Farm

local AutoAttackEnabled = false
local AttackConnection = nil

FarmTab:AddToggle("AutoAttack", {
    Title = "Auto Attack",
    Description = "Fires ByteNetReliable directly (real attack)",
    Default = false,
    Callback = function(state)
        AutoAttackEnabled = state

        if state then
            Fluent:Notify({
                Title = "Auto Attack",
                Content = "ENABLED - Firing real remote",
                Duration = 4
            })

            AttackConnection = game:GetService("RunService").Heartbeat:Connect(function()
                if not AutoAttackEnabled then return end

                local args = {
                    buffer.fromstring("\t\a\001"),
                    { tick() }  -- dynamic timestamp
                }

                pcall(function()
                    game:GetService("ReplicatedStorage").ByteNetReliable:FireServer(unpack(args))
                end)
            end)
        else
            if AttackConnection then
                AttackConnection:Disconnect()
                AttackConnection = nil
            end
            Fluent:Notify({
                Title = "Auto Attack",
                Content = "DISABLED",
                Duration = 3
            })
        end
    end
})

-- Attack Speed Slider (Very Important)
FarmTab:AddSlider("AttackDelay", {
    Title = "Attack Speed / Delay",
    Description = "Lower = faster (0.08 ~ 0.15 is usually safest)",
    Default = 0.12,
    Min = 0.05,
    Max = 0.40,
    Rounding = 3,
    Callback = function() end
})

-- Read slider value live and use better controlled loop
local currentDelay = 0.12

-- Update delay when slider changes
local sliderInstance = FarmTab:AddSlider("AttackDelay", { ... }) -- already added above
-- Better way to track slider:
task.spawn(function()
    while true do
        if AutoAttackEnabled then
            local args = {
                buffer.fromstring("\t\a\001"),
                { tick() }
            }
            pcall(function()
                game:GetService("ReplicatedStorage").ByteNetReliable:FireServer(unpack(args))
            end)
            task.wait(currentDelay)
        else
            task.wait(0.3)
        end
    end
end)

-- Update currentDelay from slider (Fluent way)
FarmTab:FindFirstChild("AttackDelay"):GetPropertyChangedSignal("Value"):Connect(function()
    currentDelay = FarmTab:FindFirstChild("AttackDelay").Value or 0.12
end)

