-- Debug section in Farm tab
local DebugSection = Tabs.Farm:AddSection("Debug & Testing")

-- Function to find the correct remote
local function FindByteNetRemote()
    -- Try multiple possible locations
    local possiblePaths = {
        game:GetService("ReplicatedStorage"):FindFirstChild("ByteNetReliable"),
        game:GetService("ReplicatedStorage"):FindFirstChild("ByteNet"):FindFirstChild("Reliable") if game:GetService("ReplicatedStorage"):FindFirstChild("ByteNet") else nil,
        game:GetService("ReplicatedStorage"):FindFirstChild("Remotes"):FindFirstChild("ByteNetReliable") if game:GetService("ReplicatedStorage"):FindFirstChild("Remotes") else nil,
    }
    
    for _, remote in ipairs(possiblePaths) do
        if remote and remote:IsA("RemoteEvent") then
            return remote
        end
    end
    
    -- If not found in common paths, search all
    for _, child in ipairs(game:GetService("ReplicatedStorage"):GetChildren()) do
        if child:IsA("RemoteEvent") and child.Name:find("ByteNet") then
            return child
        end
    end
    
    return nil
end

-- Function to fire attack with different formats
local function FireAttack()
    local remote = FindByteNetRemote()
    if not remote then return false end
    
    -- Try different argument formats
    local attempts = {
        function() remote:FireServer(buffer.fromstring("\t\a\001"), { tick() }) end,
        function() remote:FireServer("\t\a\001", { tick() }) end,
        function() remote:FireServer({ ["data"] = buffer.fromstring("\t\a\001"), ["time"] = tick() }) end,
        function() remote:FireServer(tick()) end,
        function() remote:FireServer({ tick() }) end,
    }
    
    for i, attempt in ipairs(attempts) do
        local success = pcall(attempt)
        if success then
            return true
        end
    end
    
    return false
end

-- Test button
DebugSection:AddButton({
    Title = "Test Attack",
    Description = "Fire a single test attack",
    Callback = function()
        local success = FireAttack()
        if success then
            Fluent:Notify({
                Title = "Success",
